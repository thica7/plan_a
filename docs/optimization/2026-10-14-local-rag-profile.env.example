# Explicit local production knowledge profile; source from the repository root.
# No secrets, downloads, or paid model calls are configured here.
# Model ID/revision/path and file SHA must match 2026-10-04-local-model-download-manifest.json.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
HF_HUB_DISABLE_TELEMETRY=1
KB_RETRIEVAL_MODE=hybrid
KB_EMBEDDING_PROVIDER=local-e5
KB_EMBEDDING_MODEL=intfloat/multilingual-e5-small
KB_EMBEDDING_REVISION=614241f622f53c4eeff9890bdc4f31cfecc418b3
KB_EMBEDDING_MODEL_VERSION=intfloat/multilingual-e5-small@614241f622f53c4eeff9890bdc4f31cfecc418b3
KB_EMBEDDING_DIM=384
KB_EMBEDDING_LOCAL_PATH=/private/tmp/plan-a-rag-models/intfloat--multilingual-e5-small/614241f622f53c4eeff9890bdc4f31cfecc418b3
KB_EMBEDDING_BATCH_SIZE=4
KB_EMBEDDING_MAX_LENGTH=512
KB_INDEX_VERSION=v1
KB_QDRANT_LOCAL_PATH=runs/knowledge-qdrant-local
# Optional CPU cross-encoder. Set to none to retain hybrid ranking without reranking.
KB_RERANKER_PROVIDER=local-cross-encoder
KB_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
KB_RERANKER_REVISION=953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
KB_RERANKER_MODEL_VERSION=BAAI/bge-reranker-v2-m3@953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
KB_RERANKER_LOCAL_PATH=/private/tmp/plan-a-rag-models/BAAI--bge-reranker-v2-m3/953dc6f6f85a1b2dbfca4c34a2796e7dde08d41e
KB_RERANKER_BATCH_SIZE=4
KB_RERANKER_MAX_LENGTH=512
# Missing/invalid weights preserve source text and report sparse fallback. Use 1 to reject.
KB_LOCAL_MODEL_STRICT=0
# Keep the existing KB_DB_PATH so canonical document IDs, versions, and capture times survive.
# Existing pending/hash documents need the existing /knowledge/documents/{id}/reindex operation.
# Load with `set -a; source docs/optimization/2026-10-14-local-rag-profile.env.example; set +a`.
