# Optional bearer-token gate for API routes. Disabled by default for the demo UI.
AUTH_ENABLED=false
# Required when AUTH_ENABLED=true. Prefer AUTH_TOKEN_SUBJECTS for multi-user deployments.
AUTH_BEARER_TOKENS=
AUTH_TOKEN_SUBJECTS=
AUTH_USER_ID=api-user
AUTH_USER_ROLE=analyst
AUTH_WORKSPACE_ID=default-workspace
AUTH_COOKIE_NAME=competiscope_api_token

# Optional shared cache/rate limit. Enable with docker_deploy.py --redis.
# Redis stores discardable capture caches and admission counts, never reports/billing.
REDIS_CACHE_ENABLED=false
REDIS_RATE_LIMIT_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_TTL_SECONDS=300
REDIS_RATE_LIMIT_REQUESTS=10
REDIS_RATE_LIMIT_WINDOW_SECONDS=60
REDIS_CONNECT_TIMEOUT_SECONDS=0.25

ARK_API_KEY=
ARK_MODEL=
## DeepSeek V4.1 Flash: keep the compatible primary credentials above;
## ARK_BASE_URL=https://api.deepseek.com, ARK_MODEL=deepseek-flash
## LLM_PROVIDER_NAME=deepseek (sets provider provenance and disables thinking)
LLM_PROVIDER_NAME=
# 0 preserves legacy provider output defaults; a paid run budget enforces 4096.
LLM_MAX_OUTPUT_TOKENS=0
# 0 disables the corresponding run limit. Includes retries and repairs.
RUN_LLM_MAX_TOKENS=0
RUN_LLM_MAX_COST_USD=0
# Conservative DeepSeek Flash peak USD estimate per million tokens, 2026-10-01.
# Update for another provider. Estimates are not an account billing statement.
LLM_INPUT_USD_PER_MILLION=0.3
LLM_CACHE_USD_PER_MILLION=0.006
LLM_OUTPUT_USD_PER_MILLION=1.2
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
BACKUP_LLM_API_KEY=
BACKUP_LLM_BASE_URL=https://openrouter.ai/api/v1
BACKUP_LLM_MODEL=
PPLX_API_KEY=
PPLX_BASE_URL=https://api.perplexity.ai
WEB_SEARCH_PROVIDER=perplexity
# DeepSeek native search: WEB_SEARCH_PROVIDER=deepseek. Can reuse the official
# primary DeepSeek credential above, or set a separate key here.
DEEPSEEK_API_KEY=
# Opt in to standalone official /v1/tools/search and /v1/tools/fetch APIs.
DEEPSEEK_WEB_API_ENABLED=false
DEEPSEEK_SEARCH_MODEL=deepseek-flash
DEEPSEEK_SEARCH_MAX_TOKENS=1024
DEEPSEEK_SEARCH_MAX_USES=1
WEBFETCH_V2_ROOT=
# Local development ports; CLI flags override these values.
BACKEND_PORT=8000
FRONTEND_PORT=5173
# Local KB storage. Compose overrides these two values for backend AND worker.
QDRANT_URL=http://127.0.0.1:6333
KB_DB_PATH=runs/knowledge.db
# Provider configuration is inherited from this same .env by backend and worker.
KB_EMBEDDING_PROVIDER=hash
KB_RERANKER_PROVIDER=hash
KB_VECTOR_COLLECTION=knowledge_chunks
KB_INDEX_VERSION=v1
PIP_INDEX_URL=https://pypi.org/simple
PIP_TRUSTED_HOST=
NPM_CONFIG_REGISTRY=https://registry.npmjs.org/
PLAYWRIGHT_DOWNLOAD_HOST=
APT_MIRROR=http://deb.debian.org/debian
APT_SECURITY_MIRROR=http://deb.debian.org/debian-security
COLLECTOR_TARGET_VERIFIED_SOURCES_PER_BRANCH=3
COLLECTOR_SEARCH_MAX_RESULTS=6
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
DEMO_MODE=true
LLM_TIMEOUT_SECONDS=90
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=2
LLM_RETRY_BACKOFF_SECONDS=0.25
# Optional admission/backpressure and global model slots. Disabled by default.
# Same POSIX host only: API/worker must share this journal, its lock directory,
# and identical settings. No multi-host support; cross-container shared-volume
# locking is not verified.
EXECUTION_CONTROL_ENABLED=false
EXECUTION_CONTROL_JOURNAL_PATH=runs/run_journal.db
EXECUTION_GLOBAL_RUNNING_LIMIT=2
EXECUTION_WORKSPACE_RUNNING_LIMIT=1
EXECUTION_GLOBAL_QUEUE_LIMIT=32
EXECUTION_WORKSPACE_QUEUE_LIMIT=8
EXECUTION_QUEUE_WAIT_SECONDS=60
EXECUTION_MODEL_WAIT_SECONDS=30
LLM_MAX_CONCURRENCY=4
ANALYST_REACT_ENABLED=true
ANALYST_REACT_MAX_TURNS=3
ANALYST_REACT_FANOUT_THRESHOLD=8
ANALYST_BRANCH_TIMEOUT_SECONDS=25
ANALYST_FANOUT_BRANCH_TIMEOUT_SECONDS=8
COMPARATOR_TIMEOUT_SECONDS=8
WRITER_TIMEOUT_SECONDS=600
WRITER_TASK_EXECUTION_ENABLED=0
WRITER_QUESTION_ATOMIC_ENABLED=0
ENTERPRISE_STORE_BACKEND=postgres
ENTERPRISE_DATABASE_URL=postgresql://competiscope:competiscope@127.0.0.1:55432/competiscope?connect_timeout=5
POSTGRES_DB=competiscope
POSTGRES_USER=competiscope
POSTGRES_PASSWORD=competiscope
POSTGRES_BIND=127.0.0.1:55432
APP_BIND=127.0.0.1:8080
QDRANT_BIND=127.0.0.1:6333
TEMPORAL_BIND=127.0.0.1:7233
TEMPORAL_UI_BIND=127.0.0.1:8233
RUN_ORCHESTRATION_BACKEND=temporal
TEMPORAL_TRAFFIC_PERCENT=100
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=competitive-intel
COMPLIANCE_REDACTION_ENABLED=true
COMPLIANCE_REDACT_API_KEYS=true
COMPLIANCE_REDACT_EMAILS=true
COMPLIANCE_REDACT_PHONES=true
COMPLIANCE_ALLOWED_DOMAINS=
COMPLIANCE_BLOCKED_DOMAINS=
COMPLIANCE_REQUIRE_SOURCE_URLS=false
COMPLIANCE_REQUIRE_TRACE_CONTEXT=true
PYDANTIC_AI_MODEL_BACKED_ENABLED=false
PYDANTIC_AI_MODEL_NAME=
ARTIFACT_STORAGE_BACKEND=local
ARTIFACT_STORAGE_ROOT=data/artifacts
AUTH_POLICY_ENGINE=internal
AUTH_POLICY_URL=
AUTH_POLICY_TIMEOUT_SECONDS=1.0
EVALOPS_RELEASE_MODE=advisory
EVALOPS_RELEASE_LIMIT=30

# Durable task submissions (off by default; application role must be restricted).
TASK_CENTER_ENABLED=false
TASK_CENTER_DATABASE_URL=postgresql://task_center_app:dummy@127.0.0.1:5432/competiscope
# Owner secret is used ONLY by scripts.migrate_task_center --execute.
TASK_CENTER_MIGRATION_DATABASE_URL=postgresql://migration_owner:dummy@127.0.0.1:5432/competiscope
TASK_CENTER_POOL_MIN_SIZE=1
TASK_CENTER_POOL_MAX_SIZE=8
TASK_CENTER_POOL_MAX_WAITING=128
TASK_CENTER_POOL_TIMEOUT_SECONDS=5
TASK_CENTER_STATEMENT_TIMEOUT_MS=3000
TASK_CENTER_LOCK_TIMEOUT_MS=1000
TASK_CENTER_DISPATCH_LEASE_SECONDS=30
TASK_CENTER_DISPATCH_MAX_ATTEMPTS=3
TASK_CENTER_DISPATCH_RETRY_SECONDS=1
ENTERPRISE_POOL_MAX_SIZE=4
ENTERPRISE_POOL_TIMEOUT_SECONDS=5
ENTERPRISE_STATEMENT_TIMEOUT_MS=3000
ENTERPRISE_LOCK_TIMEOUT_MS=1000
