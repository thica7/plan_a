{"id": "figma-devmode-global-v2", "title": "Figma Dev Mode features and seat prerequisites", "url": "https://help.figma.com/hc/en-us/articles/15023124644247-Guide-to-Dev-Mode-in-Figma", "product": "Figma", "market": "全球", "text": "Figma Dev Mode supports design inspection, code viewing, asset download, change comparison and design handoff. Short official prerequisites: \"Available on all paid plans\" and \"Requires a Full or a Dev seat\". Both plan and seat conditions apply. This full Dev Mode entitlement does not mean free viewers have no basic inspection features.", "role": "source", "published_at": null, "updated_at": null, "fetched_at": "2026-10-04T09:29:42Z", "source_date_status": "not_provided", "content_hash": "ec58fe2e52fade75a8fb5d1c1928d0bd1895e2eb541849fa1a2b10759090d19f", "text_kind": "verified_summary_with_short_quotes", "capture_method": "official_page_read", "provenance": {"summary_author": "AI", "primary_source": "https://help.figma.com/hc/en-us/articles/15023124644247-Guide-to-Dev-Mode-in-Figma", "verified_at": "2026-10-04T09:29:42Z", "short_quotes": ["Available on all paid plans", "Requires a Full or a Dev seat"], "human_scope_review": "user_message_2026-10-04"}, "scope_note": "Saved summaries are not continuous verbatim source text; published/updated dates remain unknown.", "structured_facts": {"capabilities": ["advanced_inspection", "codegen", "asset_download", "version_comparison", "design_handoff"], "preconditions": {"operator": "AND", "plan_level": ["Professional", "Organization", "Enterprise"], "seat_type": ["Full", "Dev"]}, "constraint_applies_to": "full Dev Mode capability", "basic_viewer_inspection_not_ruled_out": true}}
{"id": "slack-free-history-global-v2", "title": "Slack free-plan history visibility and deletion", "url": "https://slack.com/help/articles/27204752526611-Feature-limitations-on-the-free-version-of-Slack", "product": "Slack", "market": "全球", "text": "Slack free-plan history visibility is limited to recent messages and files. Short official quote: \"most recent 90 days\". Data older than one year is deleted on a rolling basis, a separate limit from search visibility. The official notice dates this deletion change to August 26, 2024.", "role": "source", "published_at": null, "updated_at": null, "fetched_at": "2026-10-04T09:29:42Z", "source_date_status": "not_provided", "content_hash": "b2c20afc182f82d79b5ed12e58299eda69e66d56d16ef192d130cd95eacb8280", "text_kind": "verified_summary_with_short_quotes", "capture_method": "official_page_read", "provenance": {"summary_author": "AI", "primary_source": "https://slack.com/help/articles/27204752526611-Feature-limitations-on-the-free-version-of-Slack", "verified_at": "2026-10-04T09:29:42Z", "short_quotes": ["most recent 90 days"], "human_scope_review": "user_message_2026-10-04"}, "scope_note": "Saved summaries are not continuous verbatim source text; published/updated dates remain unknown.", "structured_facts": {"visibility_limit": {"free_days": 90}, "retention_action": {"one_year_rolling_deletion_policy": true}, "field_sources": {"visibility_limit.free_days": ["https://slack.com/help/articles/27204752526611-Feature-limitations-on-the-free-version-of-Slack"], "retention_action.one_year_rolling_deletion_policy": ["https://slack.com/help/articles/27204752526611-Feature-limitations-on-the-free-version-of-Slack"]}}}
{"id": "slack-retention-global-v2", "title": "Slack configurable message retention", "url": "https://slack.com/intl/en-gb/help/articles/203457187-Customise-data-retention-in-Slack", "product": "Slack", "market": "全球", "text": "Slack free workspaces can select one-year retention without edit/deletion tracking, or deletion after 90 days. Paid data is retained for workspace lifetime by default; custom deletion timelines and permitted message-channel overrides can shorten this. Short official quote: \"lifetime of your workspace by default\". Enterprise-sponsored Slack Connect messages have an exception. The page does not certify every free workspace current default configuration.", "role": "source", "published_at": null, "updated_at": null, "fetched_at": "2026-10-04T09:29:42Z", "source_date_status": "not_provided", "content_hash": "544095072c4dc08ed896eee114ae4a4c46a25df173eb4dc08f23a68ff1e25e85", "text_kind": "verified_summary_with_short_quotes", "capture_method": "official_page_read", "provenance": {"summary_author": "AI", "primary_source": "https://slack.com/intl/en-gb/help/articles/203457187-Customise-data-retention-in-Slack", "verified_at": "2026-10-04T09:29:42Z", "short_quotes": ["lifetime of your workspace by default"], "human_scope_review": "user_message_2026-10-04"}, "scope_note": "Saved summaries are not continuous verbatim source text; published/updated dates remain unknown.", "structured_facts": {"retention_action": {"free_options": ["rolling_delete_after_1_year", "delete_after_90_days"], "paid_default": "retain_for_workspace_lifetime", "paid_custom_timeline_supported": true}, "free_default_configuration_verified": false, "message_channel_override_supported": true, "exceptions": ["Enterprise-sponsored Slack Connect messages may have different retention"], "scope": "ordinary workspace message history; settings and exceptions must be checked", "field_sources": {"retention_action": ["https://slack.com/intl/en-gb/help/articles/203457187-Customise-data-retention-in-Slack"], "message_channel_override_supported": ["https://slack.com/intl/en-gb/help/articles/203457187-Customise-data-retention-in-Slack"], "exceptions": ["https://slack.com/intl/en-gb/help/articles/203457187-Customise-data-retention-in-Slack"]}}}
