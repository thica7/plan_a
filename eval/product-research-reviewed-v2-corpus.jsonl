{"id": "notion-billing-global-v2", "title": "Notion billing intervals and paid seats", "url": "https://www.notion.com/help/billing", "product": "Notion", "market": "全球", "text": "Notion supports monthly or annual billing and renews on the chosen cycle. Short official quote: \"Yearly billing costs less.\" Billing depends on workspace paid seat count. Added seats are prorated for the remaining term; removals lower the next renewal bill. This evidence covers billing mechanisms, not current plan-specific amounts, currency, or taxes.", "role": "source", "published_at": null, "updated_at": null, "fetched_at": "2026-10-04T09:29:42Z", "source_date_status": "not_provided", "content_hash": "6b825a175602232ade33998c5cba2bc61ad4e6d786d7160978b61712620049fa", "text_kind": "verified_summary_with_short_quotes", "capture_method": "official_page_read", "provenance": {"summary_author": "AI", "primary_source": "https://www.notion.com/help/billing", "verified_at": "2026-10-04T09:29:42Z", "short_quotes": ["Yearly billing costs less."], "human_scope_review": "user_message_2026-10-04"}, "scope_note": "Saved summaries are not continuous verbatim source text; published/updated dates remain unknown.", "structured_facts": {"covered_dimensions": ["billing_interval", "renewal", "relative_cost", "seat_count"], "billing_intervals": ["monthly", "annual"], "annual_relative_cost": "less", "price_amount_supported": false, "price_matrix": [], "amount_question_status": "missing_entity_price", "missing_price_fields": ["plan", "currency", "amount", "tax_scope"], "old_report_amount_is_current_evidence": false}}
